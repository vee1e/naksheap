{
  "name": "naksheap-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "wasm": "npm run wasm:build",
    "wasm:build": "cargo build --release -p naksheap-wasm --target wasm32-unknown-unknown && wasm-bindgen --target web --out-dir pkg ../target/wasm32-unknown-unknown/release/naksheap_wasm.wasm",
    "prebuild": "npm run wasm:build"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  }
}
